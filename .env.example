# OTLP — where mcp-trace exports spans (Jaeger direct, or Collector via fan-out compose)
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# Agent turn parent span (OTLP/HTTP JSON)
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=http://localhost:4318
MCP_TRACE_PORT=8001
MCP_TRACE_SERVICE_NAME=agent-obs-lab

# Optional: Langfuse via Collector exporter (see docs/integrations/langfuse.md)
# Do not dual-SDK the toy agent — prefer Collector fan-out.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# LANGFUSE_AUTH_STRING=  # base64(pk:sk) for the Collector

# Optional: Arize Phoenix (local UI when using docker-compose.fanout.yml)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=agent-obs-lab
