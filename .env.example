# OTLP — where mcp-trace exports spans (Jaeger / collector via compose)
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
MCP_TRACE_PORT=8001
MCP_TRACE_SERVICE_NAME=agent-obs-lab

# Optional: Langfuse (stub — see docs/integrations/langfuse.md)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Arize Phoenix (stub — see docs/integrations/phoenix.md)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=agent-obs-lab
